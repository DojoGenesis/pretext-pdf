{
  "name": "@dojogenesis/pretext-pdf-mcp",
  "version": "0.2.0",
  "description": "MCP server for Pretext-powered PDF export — precise Canvas-based typography measurement for beautiful document generation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pretext-pdf-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "fonts/",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/smoke.test.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DojoGenesis/PretextPDFByDojoGenesis"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.4",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "canvas": "^3.1.0",
    "marked": "^15.0.0",
    "pdf-lib": "^1.17.1",
    "shiki": "^3.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Dojo Genesis",
  "license": "Apache-2.0"
}
